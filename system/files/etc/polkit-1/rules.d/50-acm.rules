// Utilizatorul principal (grupul sudo), așezat la laptop, salvează rețele Wi-Fi pentru sistem
// fără să i se mai ceară parola de cont.
polkit.addRule(function (action, subject) {
  if (subject.local && subject.active && subject.isInGroup("sudo") &&
      (action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
       action.id == "org.freedesktop.NetworkManager.network-control" ||
       action.id == "org.freedesktop.NetworkManager.enable-disable-wifi")) {
    return polkit.Result.YES;
  }
});

// Actualizările ACM OS se instalează din Setări, ca pe Windows/Mac: fără terminal și fără parolă
// pentru utilizatorul principal așezat la laptop. Doar acm-update, nimic altceva.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.policykit.exec" &&
      action.lookup("program") == "/opt/acm-os/system/bin/acm-update" &&
      subject.local && subject.active && subject.isInGroup("sudo")) {
    return polkit.Result.YES;
  }
});
