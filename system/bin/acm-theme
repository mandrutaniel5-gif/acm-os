#!/usr/bin/env bash
# Aspectul ACM OS pentru utilizatorul curent (fără sudo).
#   acm-theme ivory|obsidian|olive   schimbă tema
#   acm-theme accent '#RRGGBB'       culoarea de accent
#   acm-theme anim 0|0.5|1           animații: oprite / rapide / line
#   acm-theme auto on|off            Ivory ziua (7–19), Obsidian seara
#   acm-theme tick                   apelat de acm-tema-auto.timer
#   acm-theme status                 setările curente, ca linii cheie=valoare
set -uo pipefail
cfg="$HOME/.config/acm"; mkdir -p "$cfg"
kw() { command -v kwriteconfig6 >/dev/null && kwriteconfig6 "$@"; }

apply_theme() {
  local id="$1" name icons
  case "$id" in
    ivory) name=Ivory icons=ACM-Light ;; obsidian) name=Obsidian icons=ACM-Dark ;; olive) name=Olive icons=ACM-Dark ;;
    *) echo "folosire: acm-theme ivory|obsidian|olive|accent|anim|auto|status"; exit 2 ;;
  esac
  plasma-apply-lookandfeel --apply "com.acm.$id" >/dev/null 2>&1
  plasma-apply-colorscheme "ACM$name" >/dev/null 2>&1
  plasma-apply-wallpaperimage "/usr/share/wallpapers/ACM-$name/contents/images/2560x1600.png" >/dev/null 2>&1
  kw --file kdeglobals --group Icons --key Theme "$icons"
  kw --file kwinrc --group org.kde.kdecoration2 --key library org.kde.kwin.aurorae
  kw --file kwinrc --group org.kde.kdecoration2 --key theme "__aurorae__svg__ACM$name"
  kw --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnLeft XIA
  kw --file kwinrc --group org.kde.kdecoration2 --key ButtonsOnRight ""
  busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1 || true
  # terminalul urmează tema
  mkdir -p "$HOME/.local/share/konsole"
  sed "s/^ColorScheme=.*/ColorScheme=ACM-$name/" /usr/share/konsole/ACM.profile > "$HOME/.local/share/konsole/ACM.profile" 2>/dev/null
  echo "$id" > "$cfg/theme"
  # accentul ales rămâne după schimbarea temei
  [ -s "$cfg/accent" ] && plasma-apply-colorscheme --accent-color "$(cat "$cfg/accent")" >/dev/null 2>&1
  echo "Tema ACM $name aplicată."
}

# Coloana de widget-uri se așază în dreapta după ecranul real (dimensiune și scalare citite de Plasma
# în momentul ăsta), nu după numere scrise dinainte.
place_widgets() {
  local js='var d = desktops()[0]; var g = screenGeometry(d.screen);
var ws = d.widgets("com.acm.widgets");
for (var i = 0; i < ws.length; i++) ws[i].remove();
var w = 250, h = Math.min(560, g.height - 140);
d.addWidget("com.acm.widgets", g.width - w - 20, 48, w, h);'
  busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$js" >/dev/null 2>&1
}

# Aplicațiile ACM se adaugă în dock-ul existent (după cele deja fixate), fără refacerea desktopului.
dock_apps() {
  local js='var ps = panels();
for (var i = 0; i < ps.length; i++) {
  var ws = ps[i].widgets("org.kde.plasma.icontasks");
  for (var j = 0; j < ws.length; j++) {
    var w = ws[j]; w.currentConfigGroup = ["General"];
    // lista completă a dock-ului ACM (citirea listei vechi nu e de încredere în scripturile Plasma)
    w.writeConfig("launchers", ["applications:org.kde.dolphin.desktop", "applications:google-chrome.desktop",
      "applications:org.kde.konsole.desktop", "applications:acm-claude.desktop", "applications:acm-docs.desktop",
      "applications:acm-contabil.desktop", "applications:org.kde.gwenview.desktop", "applications:acm-actualizari.desktop",
      "applications:org.kde.plasmawindowed.desktop"]);
    try { w.reloadConfig(); } catch (e) {}
  }
}'
  busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$js" >/dev/null 2>&1
}

case "${1:-}" in
  dock) dock_apps && touch "$cfg/dock-aplicatii-2" && echo "Aplicațiile ACM sunt în dock." ;;
  widgets) place_widgets && touch "$cfg/widgets-placed" && echo "Widget-urile sunt în dreapta." ;;
  accent)
    [[ "${2:-}" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "folosire: acm-theme accent '#RRGGBB'"; exit 2; }
    echo "$2" > "$cfg/accent"
    plasma-apply-colorscheme --accent-color "$2" >/dev/null 2>&1
    echo "Accent $2." ;;
  anim)
    case "${2:-}" in 0|0.5|1) ;; *) echo "folosire: acm-theme anim 0|0.5|1"; exit 2 ;; esac
    kw --file kdeglobals --group KDE --key AnimationDurationFactor "$2"
    busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1 || true
    echo "Animații: $2." ;;
  auto)
    case "${2:-}" in
      on)  echo on > "$cfg/auto"; systemctl --user enable --now acm-tema-auto.timer >/dev/null 2>&1; "$0" tick ;;
      off) rm -f "$cfg/auto"; systemctl --user disable --now acm-tema-auto.timer >/dev/null 2>&1 ;;
      *) echo "folosire: acm-theme auto on|off"; exit 2 ;;
    esac
    echo "Tema automată: $2." ;;
  tick)
    [ -f "$cfg/auto" ] || exit 0
    h=$((10#$(date +%H)))
    want=obsidian; [ "$h" -ge 7 ] && [ "$h" -lt 19 ] && want=ivory
    [ "$(cat "$cfg/theme" 2>/dev/null)" = "$want" ] || apply_theme "$want" ;;
  status)
    echo "theme=$(cat "$cfg/theme" 2>/dev/null || echo obsidian)"
    echo "accent=$(cat "$cfg/accent" 2>/dev/null)"
    echo "auto=$([ -f "$cfg/auto" ] && echo on || echo off)"
    a="$(kreadconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 2>/dev/null)"
    echo "anim=${a:-0.5}" ;;
  *) apply_theme "${1:-}" ;;
esac
