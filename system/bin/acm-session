#!/usr/bin/env bash
# Pornește la intrarea în Plasma. Aplică aspectul ACM o dată (și din nou când crește LAYOUT).
set -uo pipefail
LAYOUT=1
cfg="$HOME/.config/acm"
mkdir -p "$cfg"
[ "$(cat "$cfg/layout" 2>/dev/null)" = "$LAYOUT" ] && exit 0

# așteaptă desktopul (max. 60 s), apoi încă puțin ca să-și termine încărcarea
for _ in $(seq 60); do busctl --user status org.kde.plasmashell >/dev/null 2>&1 && break; sleep 1; done
sleep 3

theme="$(cat "$cfg/theme" 2>/dev/null)"
/opt/acm-os/system/bin/acm-theme "${theme:-obsidian}" --reset-layout || exit 1

# căutarea pe Ctrl+Space (efect de la următoarea intrare în sesiune)
command -v kwriteconfig6 >/dev/null && kwriteconfig6 --file kglobalshortcutsrc \
  --group services --group org.kde.krunner.desktop --key _launch $'Ctrl+Space\tAlt+Space\tAlt+F2\tSearch'

echo "$LAYOUT" > "$cfg/layout"
