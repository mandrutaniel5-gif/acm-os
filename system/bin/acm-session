#!/usr/bin/env bash
# Pornește la intrarea în Plasma. Un cont nou primește aspectul ACM direct din tema implicită
# (/etc/xdg/kdeglobals). Un cont mai vechi (sau de dinainte de ACM OS 0.4) e adus la aspectul ACM o singură dată.
set -uo pipefail
cfg="$HOME/.config/acm"
applets="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
mkdir -p "$cfg"
# contul copiilor are ecranul lui (com.acm.copii), fără teme și fără bara ACM
[ "$(id -un)" = copii ] && exit 0

# poza contului = sigiliul ACM
for face in "$HOME/.face.icon" "$HOME/.face"; do
  [ -f "$face" ] && [ ! -L "$face" ] && continue   # poza aleasă de utilizator rămâne
  ln -sfn /usr/share/pixmaps/acm-os.png "$face"
done

# fără portofelul KDE: cu autentificare automată nu se deblochează niciodată și cere parola la fiecare Wi-Fi
if command -v kwriteconfig6 >/dev/null; then
  kwriteconfig6 --file kwalletrc --group Wallet --key Enabled false
  kwriteconfig6 --file kwalletrc --group Wallet --key "First Use" false
  kwriteconfig6 --file plasma-nm --group General --key SystemConnectionsByDefault true
  # pornire curată, fără aplicațiile de data trecută
  kwriteconfig6 --file ksmserverrc --group General --key loginMode emptySession
fi

# widget-urile în dreapta, după ecranul real (o dată; din nou din Setări → Aspect dacă e nevoie)
if [ ! -f "$cfg/widgets-placed" ]; then
  ( for _ in $(seq 60); do busctl --user status org.kde.plasmashell >/dev/null 2>&1 && break; sleep 1; done
    sleep 25; /opt/acm-os/system/bin/acm-theme widgets >/dev/null 2>&1 ) &
fi

# ACM Docs și ACM Contabil în dock-ul existent, o dată, după ce s-au instalat
if [ ! -f "$cfg/dock-aplicatii-2" ] && [ -f /usr/share/applications/acm-docs.desktop ]; then
  ( sleep 30; /opt/acm-os/system/bin/acm-theme dock >/dev/null 2>&1 ) &
fi

# programe KDE care pornesc la fiecare intrare și nu ne trebuie (pornire mai rapidă pe Core 2 Duo)
mkdir -p "$HOME/.config/autostart"
for a in org.kde.xwaylandvideobridge org.kde.discover.notifier org.kde.kdeconnect.daemon baloo_file \
         org.kde.kalendarac org.kde.plasma-welcome geoclue-demo-agent org.kde.kgpg; do
  [ -f "/etc/xdg/autostart/$a.desktop" ] || continue
  printf '[Desktop Entry]\nHidden=true\n' > "$HOME/.config/autostart/$a.desktop"
done

# parola Wi-Fi scrisă la pornirea asta se mută în sistem, ca data viitoare să nu mai fie cerută
( for t in 60 240 600; do sleep "$t"; /opt/acm-os/system/bin/acm-ctl wifi-keep >/dev/null 2>&1; done ) &

# căutarea pe Ctrl+Space
command -v kwriteconfig6 >/dev/null && kwriteconfig6 --file kglobalshortcutsrc \
  --group services --group org.kde.krunner.desktop --key _launch $'Ctrl+Space\tAlt+Space\tAlt+F2\tSearch'

[ -f "$cfg/theme" ] && grep -q "plugin=com.acm.launchpad" "$applets" 2>/dev/null && exit 0

for _ in $(seq 60); do busctl --user status org.kde.plasmashell >/dev/null 2>&1 && break; sleep 1; done
sleep 2
theme="$(cat "$cfg/theme" 2>/dev/null)"
/opt/acm-os/system/bin/acm-theme "${theme:-obsidian}"

# aranjamentul vechi (bara Debian) se înlocuiește: desktopul repornește și ia aranjamentul ACM
if ! grep -q "plugin=com.acm.launchpad" "$applets" 2>/dev/null; then
  systemctl --user stop plasma-plasmashell.service
  [ -f "$applets" ] && mv "$applets" "$applets.inainte-de-acm"
  systemctl --user start plasma-plasmashell.service
fi
