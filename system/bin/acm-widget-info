#!/usr/bin/env bash
# Date pentru widget-ul ACM de pe desktop, ca linii cheie=valoare.
bat=""; for b in /sys/class/power_supply/BAT*; do [ -r "$b/capacity" ] && bat="$b" && break; done
if [ -n "$bat" ]; then
  echo "bat=$(cat "$bat/capacity")"
  echo "batstate=$(cat "$bat/status")"
  # minute până la plin / gol, din încărcare și curent
  now="$(cat "$bat/charge_now" 2>/dev/null)"; full="$(cat "$bat/charge_full" 2>/dev/null)"; cur="$(cat "$bat/current_now" 2>/dev/null)"
  if [ -n "$now" ] && [ -n "$full" ] && [ -n "$cur" ] && [ "$cur" -gt 0 ]; then
    case "$(cat "$bat/status")" in
      Charging) echo "batmin=$(( (full - now) * 60 / cur ))" ;;
      Discharging) echo "batmin=$(( now * 60 / cur ))" ;;
    esac
  fi
else
  echo "bat="
fi
"$(dirname "$(readlink -f "$0")")/acm-battery" info 2>/dev/null | grep '^doctor='
awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "memused=%.1f\nmemtotal=%.1f\n", (t-a)/1048576, t/1048576}' /proc/meminfo
echo "boot=$(systemd-analyze 2>/dev/null | sed -n 's/.*= *\([0-9.]*\)s$/\1/p' | head -n1)"
echo "version=$(sed -n 's/^VERSION=//p' /etc/acm-release)"
[ -f /var/lib/acm/available ] && echo "available=$(cat /var/lib/acm/available)"

# vremea în Oradea, reîmprospătată cel mult o dată la 30 de minute
w="$HOME/.cache/acm/vreme"; mkdir -p "${w%/*}"
if [ ! -s "$w" ] || [ -n "$(find "$w" -mmin +30 2>/dev/null)" ]; then
  curl -fsm 6 "https://wttr.in/Oradea?format=%t+%C&lang=ro&m" 2>/dev/null | head -c 60 | tr -d '+' > "$w.n" && [ -s "$w.n" ] \
    && ! grep -qi 'unknown\|error' "$w.n" && mv "$w.n" "$w"
  rm -f "$w.n"
fi
[ -s "$w" ] && echo "weather=$(sed 's/ *$//' "$w")"

n=0; total=0
for d in "$HOME"/Proiecte/*/; do
  [ -d "$d" ] || continue
  total=$((total + 1))
  [ $n -ge 3 ] && continue
  echo "proj$n=$(basename "$d")|$(date -r "$d" +%d.%m)"
  n=$((n + 1))
done
echo "projcount=$total"
