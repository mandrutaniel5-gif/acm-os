#!/usr/bin/env bash
# Aduce sistemul la starea descrisă de versiunea curentă din /opt/acm-os.
# Se poate rula de oricâte ori: fiecare pas verifică întâi ce e deja făcut.
set -uo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/acm-common.sh"
need_root

SYS="$ACM_DIR/system"
USER_NAME="$(main_user)"
VERSION="$(cat "$ACM_DIR/VERSION")"
# ACM_IMAGE=1: rulăm în chroot-ul de construire a ISO-ului (fără utilizator, fără kernel propriu, fără Btrfs)
IMAGE="${ACM_IMAGE:-0}"
export DEBIAN_FRONTEND=noninteractive
mkdir -p "$ACM_STATE"

say "ACM OS $VERSION — aplic configurația"

# 1. Surse apt: contrib/non-free (driver Wi-Fi) + Google Chrome
if [ -f /etc/apt/sources.list.d/debian.sources ]; then
  tmp="$(mktemp)" && enable_nonfree_deb822 < /etc/apt/sources.list.d/debian.sources > "$tmp" \
    && cat "$tmp" > /etc/apt/sources.list.d/debian.sources; rm -f "$tmp"
fi
if [ -s /etc/apt/sources.list ]; then
  tmp="$(mktemp)" && enable_nonfree_list < /etc/apt/sources.list > "$tmp" && cat "$tmp" > /etc/apt/sources.list; rm -f "$tmp"
fi
if [ ! -f /usr/share/keyrings/google-chrome.gpg ]; then
  curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg
fi
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
  > /etc/apt/sources.list.d/google-chrome.list
ok "surse apt"

# 2. Pachete
apt-get update -q
mapfile -t PKGS < <(sed 's/#.*//' "$SYS/packages.txt" | tr -s ' \t' '\n' | grep -v '^$')
[ "$IMAGE" = 1 ] || PKGS+=("linux-headers-$(uname -r)")
# dacă un pachet lipsește din arhivă, apt refuză tot; atunci le instalăm pe rând
apt-get install -y -q "${PKGS[@]}" || for p in "${PKGS[@]}"; do apt-get install -y -q "$p" || warn "nu s-a instalat: $p"; done
# ce nu face parte din ACM OS (Chrome e browserul; ecranul de bun venit KDE)
apt-get purge -y -q plasma-welcome firefox-esr >/dev/null 2>&1 || true
# aplicații KDE pe care ACM OS le înlocuiește (Chrome, Setări ACM, acm-update), doar dacă nu iau desktopul cu ele
for p in konqueror plasma-discover khelpcenter kdeconnect; do
  dpkg -s "$p" >/dev/null 2>&1 || continue
  if apt-get -s purge "$p" | grep -qE '^(Remv|Purg) (plasma-desktop|plasma-workspace|systemsettings|dolphin|konsole) '; then
    warn "păstrez $p (alte componente depind de el)"
  else
    apt-get purge -y -q "$p" >/dev/null 2>&1 || true
  fi
done
ok "pachete"

# 3. Fișierele ACM OS peste sistem
cp -a "$SYS/files/." /
ok "fișiere de sistem"

# 4. Limbă, oră, tastatură
sed -i 's/^# *ro_RO.UTF-8/ro_RO.UTF-8/' /etc/locale.gen && locale-gen >/dev/null
update-locale LANG=ro_RO.UTF-8
timedatectl set-timezone Europe/Bucharest 2>/dev/null || ln -sf /usr/share/zoneinfo/Europe/Bucharest /etc/localtime
[ "$IMAGE" = 1 ] || timedatectl set-ntp true 2>/dev/null || true
update-ca-certificates >/dev/null 2>&1 || true
ok "română, ora României"

# 5. Pornire rapidă: GRUB fără așteptare (Shift arată meniul), autologin în Plasma
[ "$IMAGE" = 1 ] || update-grub >/dev/null 2>&1 || true
SESSION=plasma
[ -f /usr/share/xsessions/plasmax11.desktop ] && SESSION=plasmax11
if [ -n "$USER_NAME" ]; then
  mkdir -p /etc/sddm.conf.d
  # dacă modul copii e pornit, rămâne pornit
  who="$USER_NAME"; grep -q '^User=copii$' /etc/sddm.conf.d/acm-autologin.conf 2>/dev/null && who=copii
  printf '[Autologin]\nUser=%s\nSession=%s\nRelogin=true\n' "$who" "$SESSION" > /etc/sddm.conf.d/acm-autologin.conf
fi
ok "pornire rapidă ($SESSION)"

# 6. Servicii
systemctl enable -q mbpfan 2>/dev/null || true
for s in ModemManager.service cups-browsed.service; do systemctl disable -q --now "$s" 2>/dev/null || true; done
systemctl enable -q acm-update-check.timer acm-firstboot.service
# pornire rapidă: nimic nu așteaptă rețeaua; preload ține pregătite aplicațiile folosite des
systemctl disable -q NetworkManager-wait-online.service 2>/dev/null || true
systemctl enable -q preload 2>/dev/null || true
systemctl --global enable -q acm-prio.timer 2>/dev/null || true
sysctl -q --system >/dev/null 2>&1 || true
[ "$IMAGE" = 1 ] || touch "$ACM_STATE/firstboot-done"
# rețelele Wi-Fi salvate țin parola în sistem, nu în portofelul KDE (care cerea parola la fiecare conectare)
if [ "$IMAGE" != 1 ] && command -v nmcli >/dev/null; then
  "$SYS/bin/acm-ctl" wifi-keep "$USER_NAME" >/dev/null 2>&1 || true
fi
ok "servicii"

# 7. Snapshot-uri (doar dacă discul e Btrfs)
if [ "$(findmnt -no FSTYPE /)" = btrfs ]; then
  [ -f /etc/snapper/configs/root ] || snapper -c root create-config /
  snapper -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 >/dev/null
  ok "snapshot-uri active"
else
  warn "discul nu e Btrfs: actualizările merg, dar fără anulare"
fi

# 8. Claude Code (pentru utilizatorul principal)
# Claude Code nativ (și pachetul npm de la 2.1.113 încolo) cere instrucțiuni AVX2, pe care Core 2 Duo
# nu le are („instrucțiune ilegală”). Pe procesoare fără AVX2 rămâne ultima versiune JavaScript,
# care rulează pe Node, fără actualizare automată (altfel ar trece singură pe varianta nativă).
CLAUDE_JS=2.1.112
claude_ok() { runuser -l "$USER_NAME" -c 'claude --version' >/dev/null 2>&1; }
if [ -n "$USER_NAME" ]; then
  if grep -qw avx2 /proc/cpuinfo; then
    if ! claude_ok && [ ! -f "$ACM_STATE/claude-incercat" ]; then
      say "instalez Claude Code (o singură dată)"
      runuser -l "$USER_NAME" -c 'curl -fsSL https://claude.ai/install.sh | bash' >/dev/null 2>&1
      touch "$ACM_STATE/claude-incercat"
    fi
  else
    # binarul nativ din casa utilizatorului e mutat de utilizator însuși (nu de root)
    runuser -l "$USER_NAME" -c '[ -e "$HOME/.local/bin/claude" ] && ! "$HOME/.local/bin/claude" --version >/dev/null 2>&1 &&
      mv -f "$HOME/.local/bin/claude" "$HOME/.local/bin/claude.nu-merge-pe-acest-procesor"' >/dev/null 2>&1 || true
    if [ "$(npm ls -g --depth=0 @anthropic-ai/claude-code 2>/dev/null | grep -o '@[0-9.]*$')" != "@$CLAUDE_JS" ]; then
      say "instalez Claude Code $CLAUDE_JS (varianta pentru procesoare mai vechi)"
      npm install -g -q "@anthropic-ai/claude-code@$CLAUDE_JS" >/dev/null 2>&1 || warn "Claude Code nu s-a instalat (internet?)"
    fi
    mkdir -p /etc/claude-code
    [ -f /etc/claude-code/managed-settings.json ] || printf '{\n  "env": { "DISABLE_AUTOUPDATER": "1" }\n}\n' > /etc/claude-code/managed-settings.json
  fi
  if claude_ok; then ok "Claude Code"; else warn "Claude Code nu pornește încă"; fi
fi

# 9. Aspectul ACM: ecran de pornire, numele sistemului
if command -v plymouth-set-default-theme >/dev/null && [ "$(plymouth-set-default-theme)" != acm ]; then
  plymouth-set-default-theme acm && update-initramfs -u >/dev/null 2>&1
fi
mkdir -p /etc/xdg
printf "[General]
Name=ACM OS
Version=%s
LogoPath=/usr/share/pixmaps/acm-os.png
Website=https://github.com/mandrutaniel5-gif/acm-os
" "$VERSION" > /etc/xdg/kcm-about-distrc
gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
# Favoritele implicite din meniu (ale KDE-ului: Konqueror, Discover…) devin ale ACM OS
kick=/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml
[ -f "$kick" ] && perl -0pi -e 's|(<entry name="favorites"[^>]*>.*?<default>)[^<]*(</default>)|${1}google-chrome.desktop,org.kde.dolphin.desktop,org.kde.konsole.desktop,org.kde.plasmawindowed.desktop,acm-actualizari.desktop${2}|s' "$kick"
# Căutarea pe Ctrl+Space: scurtătura implicită vine din lansatorul KRunner
if [ -f /usr/share/applications/org.kde.krunner.desktop ]; then
  mkdir -p /usr/local/share/applications
  sed 's/^X-KDE-Shortcuts=.*/X-KDE-Shortcuts=Ctrl+Space,Alt+Space,Alt+F2,Search/' /usr/share/applications/org.kde.krunner.desktop \
    > /usr/local/share/applications/org.kde.krunner.desktop
fi
# Setările ACM înlocuiesc lansatorul KDE din dock (versiunile 0.2 îi schimbau iconița)
rm -f /usr/local/share/applications/systemsettings.desktop
sed -i -e 's/^NAME=.*/NAME="ACM OS"/' -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"ACM OS $VERSION\"/" /usr/lib/os-release
printf 'ACM OS %s \\n \\l\n\n' "$VERSION" > /etc/issue
# Aplicațiile cu nume ACM, în română; utilitarele KDE de care nu ai nevoie nu mai apar în lansator.
# Copii locale în /usr/local/share/applications (au prioritate și supraviețuiesc actualizărilor).
mkdir -p /usr/local/share/applications
while IFS='|' read -r id name; do
  src="/usr/share/applications/$id.desktop"; [ -f "$src" ] || continue
  awk -v name="$name" '
    /^\[/ { sec = $0; print; if (sec == "[Desktop Entry]") print "Name=" name; next }
    sec == "[Desktop Entry]" && /^(Name|GenericName)(\[[^]]*\])?=/ { next }
    { print }' "$src" > "/usr/local/share/applications/$id.desktop"
done <<'NAMES'
org.kde.dolphin|Fișiere
org.kde.konsole|Terminal
org.kde.gwenview|Poze
org.kde.okular|Documente
org.kde.ark|Arhive
org.kde.spectacle|Captură de ecran
org.kde.kwrite|Notițe
org.kde.kate|Editor de cod
org.kde.kcalc|Calculator
google-chrome|Chrome
tuxpaint|Desen
org.kde.ktuberling|Cartoful
NAMES
for id in systemsettings kdesystemsettings org.kde.kinfocenter org.kde.kmenuedit org.kde.khelpcenter \
          org.kde.kwalletmanager5 org.kde.kwalletmanager org.kde.discover org.kde.konqueror org.kde.ksystemlog \
          org.kde.drkonqi org.kde.kfind org.kde.plasma-welcome org.kde.kdeconnect.app org.kde.kdeconnect.sms \
          org.kde.kdeconnect-settings org.kde.kdeconnect.nonplasma org.kde.plasma.emojier org.kde.kuserfeedback-console \
          org.kde.kmousetool org.kde.kmag org.kde.kmouth org.kde.klipper org.kde.plasma.themeexplorer \
          xterm debian-xterm debian-uxterm vim gvim nm-connection-editor display-im6.q16 htop info yelp \
          install-debian org.freedesktop.IBus.Setup ibus-setup im-config qv4l2 qvidcap \
          tuxpaint-config org.kde.partitionmanager org.kde.drkonqi.coredump.gui zutty \
          org.kde.plasma-systemmonitor; do
  src="/usr/share/applications/$id.desktop"; [ -f "$src" ] || continue
  awk '{ print } /^\[Desktop Entry\]$/ { print "NoDisplay=true" }' "$src" | grep -v '^NoDisplay=false' \
    > "/usr/local/share/applications/$id.desktop"
done
update-desktop-database -q /usr/local/share/applications 2>/dev/null || true
ok "aspect ACM"

# Modul copii: contul „copii”, fără parolă, cu ecranul de butoane mari și fără setări
if [ "$IMAGE" != 1 ]; then
  if ! id copii >/dev/null 2>&1; then
    useradd -m -u 2000 -c "Copii" -s /bin/bash -G audio,video copii
  fi
  # parolă blocată: intră doar automat (SDDM), nu și din consolă
  passwd -l copii >/dev/null 2>&1 || true
  kh="$(getent passwd copii | cut -d: -f6)"
  if [ -n "$kh" ]; then
    # fișierele se scriu ca utilizatorul copii, nu ca root: o legătură pusă în casa lui nu poate atinge sistemul
    runuser -u copii -- sh -c 'mkdir -p "$1/.config" && cat > "$1/.config/kdeglobals"' sh "$kh" <<'KIDS'
[KDE]
LookAndFeelPackage=com.acm.copii

[General]
ColorScheme=ACMIvory

[Icons]
Theme=ACM-Light

[KDE Action Restrictions][$i]
run_command=false
shell_access=false
action/run_command=false
logout=false
lock_screen=false
plasma/allow_configure_when_locked=false
plasma-desktop/add_activities=false
KIDS
    printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' |
      runuser -u copii -- sh -c 'cat > "$1/.config/kscreenlockerrc"' sh "$kh"
  fi
  ok "mod copii pregătit"
fi

# 10. Comenzile ACM și versiunea
ln -sf "$SYS/bin/acm-update" /usr/local/bin/acm-update
ln -sf "$SYS/bin/acm-apply"  /usr/local/bin/acm-apply
for c in acm-theme acm-battery acm-setari acm-ctl acm-apps acm-prio; do ln -sf "$SYS/bin/$c" "/usr/local/bin/$c"; done
printf 'NAME="ACM OS"\nVERSION=%s\n' "$VERSION" > /etc/acm-release
ok "ACM OS $VERSION aplicat"
