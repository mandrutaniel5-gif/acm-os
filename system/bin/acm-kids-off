#!/usr/bin/env bash
# Iese din modul copii: intrarea automată revine la contul părintelui.
# Rulat prin pkexec; cere parola unui administrator (părintele).
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/acm-common.sh"
conf=/etc/sddm.conf.d/acm-autologin.conf
session="$(sed -n 's/^Session=//p' "$conf" 2>/dev/null)"
printf '[Autologin]\nUser=%s\nSession=%s\nRelogin=true\n' "$(main_user)" "${session:-plasma}" > "$conf"
