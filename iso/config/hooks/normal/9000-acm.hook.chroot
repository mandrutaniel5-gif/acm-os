#!/bin/sh
# Pune ACM OS în imagine: clonează repository-ul la ultima versiune și aplică configurația.
set -e
# /opt/acm-os vine din build.sh (commit-ul construit); altfel ultima versiune de pe GitHub
if [ ! -d /opt/acm-os/.git ]; then
  git clone -q https://github.com/mandrutaniel5-gif/acm-os.git /opt/acm-os
  tag="$(git -C /opt/acm-os tag -l 'v*' | sed 's/^v//' | sort -V | tail -n1)"
  git -C /opt/acm-os checkout -q "v$tag"
fi
git config --system --add safe.directory /opt/acm-os
ACM_IMAGE=1 /opt/acm-os/system/bin/acm-apply

# Instalatorul se numește „Instalează ACM OS”
for f in /usr/share/applications/*calamares*.desktop /usr/share/applications/install-debian.desktop /etc/skel/Desktop/*.desktop; do
  [ -f "$f" ] && sed -i -e 's/^Name=.*/Name=Instalează ACM OS/' -e 's/^Name\[ro\]=.*/Name[ro]=Instalează ACM OS/' "$f"
done


# Instalatorul arată „ACM OS”, nu „Debian”
b=/etc/calamares/branding/debian
if [ -f "$b/branding.desc" ]; then
  cp /usr/share/pixmaps/acm-os.png "$b/acm-os.png"
  sed -i -E \
    -e '/^\s*(productName|shortProductName|versionedName|shortVersionedName|bootloaderEntryName):/s/:.*/: "ACM OS"/' \
    -e '/^\s*(productLogo|productIcon|productWelcome):/s/:.*/: "acm-os.png"/' \
    "$b/branding.desc"
fi
apt-get clean
